-- ============================================================
-- DAMAGE HITBOX
-- ============================================================
local function activateKillCheck()
	coroutine.wrap(function()
		while entityModel.Parent ~= nil do
			task.wait(0.01)
			for _, player in ipairs(Players:GetPlayers()) do
				local character = player.Character
				if character and character:FindFirstChild("HumanoidRootPart") then
					local distance =
						(rootPart.Position - character.HumanoidRootPart.Position).Magnitude

					if distance < DAMAGE_RADIUS
						and not hitPlayers[player.UserId]
						and not isPlayerHiding(player) then

						hitPlayers[player.UserId] = true
						local humanoid = character:FindFirstChildOfClass("Humanoid")
						if humanoid and humanoid.Health > 0 then
							humanoid.Health = 0
						end
					end
				end
			end
		end
	end)()
end

-- ============================================================
-- PATH HELPERS
-- ============================================================
local function tweenTo(toPos)
	if entityModel.Parent == nil then return false end
	local dist = (toPos - rootPart.Position).Magnitude
	local tweenTime = math.max(dist / SPEED, 0.05)
	local tween = TweenService:Create(
		rootPart,
		TweenInfo.new(tweenTime, Enum.EasingStyle.Linear),
		{ CFrame = CFrame.new(toPos) }
	)
	tween:Play()
	tween.Completed:Wait()
	return entityModel.Parent ~= nil
end

local function runPath(entries, pauseAtEnd)
	for i = 1, #entries - 1 do
		breakLightsInRoom(entries[i + 1].room)
		if not tweenTo(entries[i + 1].pos) then return false end
	end
	if pauseAtEnd and END_DELAY > 0 then
		local t0 = os.clock()
		while os.clock() - t0 < END_DELAY do
			if entityModel.Parent == nil then return false end
			task.wait(0.1)
		end
	end
	return true
end

local function findRoomsFolder()
	local names = {"CurrentRooms", "Rooms", "Room", "Corridors", "Level"}
	for _, n in ipairs(names) do
		local f = workspace:FindFirstChild(n)
		if f then return f end
	end
	for _, child in ipairs(workspace:GetChildren()) do
		for _, n in ipairs(names) do
			local f = child:FindFirstChild(n)
			if f then return f end
		end
	end
	return nil
end

-- ============================================================
-- ATTACK
-- ============================================================
local function launchAttack()
	local roomsFolder = findRoomsFolder()
	if not roomsFolder then
		entityModel:Destroy()
		return
	end

	local roomList = roomsFolder:GetChildren()
	table.sort(roomList, function(a, b)
		local numA = tonumber(a.Name:match("%d+")) or 0
		local numB = tonumber(b.Name:match("%d+")) or 0
		return numA < numB
	end)

	local entries = {}
	for _, room in ipairs(roomList) do
		local door = room:FindFirstChild("Door", true)
		local pos = nil
		if door and door:IsA("BasePart") then
			pos = door.Position
		elseif room:IsA("Model") then
			pos = room:GetPivot().Position
		elseif room:IsA("BasePart") then
			pos = room.Position
		end
		if pos then
			table.insert(entries, {pos = pos, room = room})
		end
	end

	if #entries == 0 then
		entityModel:Destroy()
		return
	end

	local reversed = {}
	for i = #entries, 1, -1 do
		table.insert(reversed, entries[i])
	end

	rootPart.CFrame = CFrame.new(entries[1].pos)
	breakLightsInRoom(entries[1].room)

	farSound:Play()
	closeSound:Play()

	shakeActive = true

	if not runPath(entries, true) then
		shakeActive = false
		return
	end

	for bounce = 1, REBOUND_COUNT do
		if not runPath(reversed, true) then
			shakeActive = false
			return
		end
		if bounce < REBOUND_COUNT then
			if not runPath(entries, true) then
				shakeActive = false
				return
			end
		end
	end

	for _, player in ipairs(Players:GetPlayers()) do
		if not hitPlayers[player.UserId] then
			coroutine.wrap(awardFakeAchievement)(player)
		end
	end

	shakeActive = false

	task.wait(1)
	farSound:Stop()
	closeSound:Stop()
	if faceConn then faceConn:Disconnect() end
	if monsterFog and monsterFog.Parent then
		monsterFog:Destroy()
	end
	entityModel:Destroy()
end

activateKillCheck()
task.wait(2)
coroutine.wrap(launchAttack)()
