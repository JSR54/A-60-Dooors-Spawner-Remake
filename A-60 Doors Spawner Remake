-- ============================================================
-- HIDING DETECTION
-- ============================================================
local function nameMatchesHiding(name)
	local n = string.lower(name)
	for _, key in ipairs(HIDING_NAMES) do
		if string.find(n, string.lower(key), 1, true) then
			return true
		end
	end
	return false
end

local function isPlayerHiding(player)
	local character = player.Character
	if not character then return false end

	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not hrp then return false end

	local node = character
	while node and node ~= workspace do
		if nameMatchesHiding(node.Name) then return true end
		node = node.Parent
	end

	for _, attr in ipairs(HIDING_ATTRS) do
		local ok, val = pcall(function() return character:GetAttribute(attr) end)
		if ok and val then return true end
		local ok2, val2 = pcall(function() return player:GetAttribute(attr) end)
		if ok2 and val2 then return true end
	end

	for _, tag in ipairs(HIDING_TAGS) do
		if CollectionService:HasTag(character, tag) then return true end
	end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {entityModel, character}
	params.IgnoreWater = true

	local hit = workspace:Raycast(rootPart.Position, hrp.Position - rootPart.Position, params)
	if hit then return true end

	local overlapParams = OverlapParams.new()
	overlapParams.FilterType = Enum.RaycastFilterType.Exclude
	overlapParams.FilterDescendantsInstances = {character, entityModel}

	local nearby = workspace:GetPartBoundsInBox(
		hrp.CFrame, Vector3.new(2, 2, 2), overlapParams
	)
	for _, p in ipairs(nearby) do
		if p.CanCollide and p.Transparency > 0.4 then return true end
		if nameMatchesHiding(p.Name) then return true end
		if p.Parent and nameMatchesHiding(p.Parent.Name) then return true end
	end

	return false
end

-- ============================================================
-- LIGHT BREAKING
-- ============================================================
local function killLight(light)
	coroutine.wrap(function()
		for _ = 1, FLICKER_COUNT do
			if not light or not light.Parent then return end
			light.Enabled = not light.Enabled
			task.wait(FLICKER_DELAY)
		end
		if light and light.Parent then
			light.Enabled = false
			light:Destroy()
		end
	end)()
end

local function killNeon(part)
	coroutine.wrap(function()
		local origMat   = part.Material
		local origColor = part.Color

		for _ = 1, FLICKER_COUNT do
			if not part or not part.Parent then return end
			part.Material = Enum.Material.SmoothPlastic
			part.Color = Color3.fromRGB(20, 20, 20)
			task.wait(FLICKER_DELAY)

			if not part or not part.Parent then return end
			part.Material = origMat
			part.Color    = origColor
			task.wait(FLICKER_DELAY)
		end

		if part and part.Parent then
			part.Material = Enum.Material.SmoothPlastic
			part.Color    = Color3.fromRGB(15, 15, 15)
		end
	end)()
end

local function breakLightsInRoom(room)
	if not room then return end

	for _, desc in ipairs(room:GetDescendants()) do
		if desc:IsA("PointLight")
			or desc:IsA("SpotLight")
			or desc:IsA("SurfaceLight") then
			if not brokenLights[desc] then
				brokenLights[desc] = true
				killLight(desc)
			end
		elseif desc:IsA("BasePart")
			and desc.Material == Enum.Material.Neon then
			if not brokenLights[desc] then
				brokenLights[desc] = true
				killNeon(desc)
			end
		end
	end
end

-- ============================================================
-- PROXIMITY AUDIO + CAMERA SHAKE
-- ============================================================
local cam = workspace.CurrentCamera

local faceConn
faceConn = RunService.Heartbeat:Connect(function()
	if not entityModel.Parent then
		if faceConn then faceConn:Disconnect() end
		return
	end

	if not cam then cam = workspace.CurrentCamera end
	if not cam then return end

	local camPos = cam.CFrame.Position
	local dist = (rootPart.Position - camPos).Magnitude

	-- Make the face part look at the camera
	local targetXZ = Vector3.new(camPos.X, rootPart.Position.Y, camPos.Z)
	if (targetXZ - rootPart.Position).Magnitude > 0.05 then
		facePart.CFrame = CFrame.lookAt(rootPart.Position, targetXZ)
	end

	local farT = math.clamp(
		(dist - FAR_SILENT_DIST) / (FAR_FULL_DIST - FAR_SILENT_DIST), 0, 1
	)
	local closeT = math.clamp(
		(CLOSE_SILENT_DIST - dist) / (CLOSE_SILENT_DIST - CLOSE_FULL_DIST), 0, 1
	)

	farSound.Volume   = farT   * FAR_MAX_VOL
	closeSound.Volume = closeT * CLOSE_MAX_VOL
end)

RunService:BindToRenderStep(
	"A60_Shake",
	Enum.RenderPriority.Camera.Value + 1,
	function(dt)
		if not shakeActive then return end
		if not entityModel.Parent then return end
		if not cam then cam = workspace.CurrentCamera end
		if not cam then return end

		local dist = (rootPart.Position - cam.CFrame.Position).Magnitude

		local t = 1 - math.clamp(
			(dist - SHAKE_FULL_DIST) / (SHAKE_RANGE - SHAKE_FULL_DIST), 0, 1
		)
		local intensity = t * t
		if intensity <= 0 then return end

		local o = MAX_OFFSET * intensity
		local a = MAX_ANGLE  * intensity

		local rx = (math.random() * 2 - 1) * o
		local ry = (math.random() * 2 - 1) * o
		local rz = (math.random() * 2 - 1) * o * 0.4

		local ra = (math.random() * 2 - 1) * a
		local rb = (math.random() * 2 - 1) * a
		local rc = (math.random() * 2 - 1) * a * 1.5

		cam.CFrame = cam.CFrame
			* CFrame.new(rx, ry, rz)
			* CFrame.Angles(ra, rb, rc)
	end
)

